# Nur für lokalen Betrieb am PC. In der Cloud stattdessen GitHub-Secrets nutzen (siehe README).
# Kopieren nach .env und ausfüllen (.env NIE hochladen/teilen!)
# --- 0-€-Modus ---
GEMINI_API_KEY=          # gratis: aistudio.google.com -> "Get API key"
POLLINATIONS_KEY=        # optional, gratis: enter.pollinations.ai (kein Wasserzeichen, höheres Limit)

# --- Upgrade (bezahlt, erst später nötig) ---
ANTHROPIC_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

# TikTok (developers.tiktok.com -> App mit Login Kit + Content Posting API / Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://deine-seite.de/callback

# Instagram (Professional-Konto, Meta-App mit "Instagram API with Instagram Login")
IG_USER_ID=
IG_ACCESS_TOKEN=
